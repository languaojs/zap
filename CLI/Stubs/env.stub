# ---ENVIRONMENT--- #
## development or production
## DEV_SERVER=NATIVE or WAMP or XAMPP
## When using PHP NATIVE development server, BASE_URL=localhost:8000
## and run php -S localhost:8000 -t public server.php
## Otherwise, when using WAMP or XAMPP, BASE_URL=localhost/app_folder
## In production, BASE_URL=your-domain without protocol

ENVIRONMENT=development
DEV_SERVER=WAMP
BASE_URL=localhost/zap

# ---SESSION_NAME--- #
SESSION_NAME=myapp

# ---DATABASE--- #
## DRIVER = mysql or sqlite
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=aistant
DB_DRIVER=mysql
DB_PORT=
SQLITE_PATH=storage/database.sqlite

# ---EMAIL--- #
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASS=
EMAIL_PORT=
EMAIL_SECURE=

# ---KEYS--- #
##Generate new key using php zap generate --key
ZAP_KEY=f7d57ea8026e7cd5bb963cdf1163509c71393b80cdf3f835651180c9d669d94c